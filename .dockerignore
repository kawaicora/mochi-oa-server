# 依赖：禁止把本机/本地 node_modules 带进容器覆盖 npm ci 的产物
node_modules
server/node_modules
**/node_modules

# 编译产物（容器内自己 build）
dist
server/dist

# 本地数据 / 上传存储（运行时挂载，不进镜像）
data
server/data

# 环境与密钥（.env 需被 Dockerfile COPY .env 使用，保留；其他本地环境文件排除）
.env.local
*.env.local

# 版本控制
.git
.gitignore

# 日志 / 调试
*.log
npm-debug.log*
*.tsbuildinfo

# 打包产物
release
out
