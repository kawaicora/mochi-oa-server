# 依赖：禁止把本机/本地 node_modules 带进容器（镜像内 npm ci --omit=dev 重新安装）
node_modules
server/node_modules
**/node_modules

# 业务源代码 / 编译工具：不进镜像、不进构建上下文（镜像只含字节码二进制）
server/src
server/tools
server/tsconfig*.json

# 编译产物（宿主编译后 COPY server/dist 进镜像，此处保留以便上下文可 COPY）
# （不排除 server/dist —— Dockerfile 需要它；但 dist 只含 index.js + app.jsc 二进制）

# 本地数据 / 上传存储（运行时挂载，不进镜像）
data
server/data

# 环境与密钥（.env 需被 Dockerfile COPY .env 使用，保留；其他本地环境文件排除）
.env.local
*.env.local

# 版本控制
.git
.gitignore

# 日志 / 调试
*.log
npm-debug.log*
*.tsbuildinfo

# 打包产物
release
out
